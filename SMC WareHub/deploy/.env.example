# Sao chép thành deploy/.env rồi điền giá trị thật (file .env KHÔNG được commit).
# Mật khẩu MySQL root. Đừng dùng dấu ; hoặc = vì được ghép vào chuỗi kết nối.
DB_PASSWORD=
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự; giữ nguyên qua các lần triển khai (đổi sẽ làm mọi người phải đăng nhập lại).
JWT_SECRET=
DEFAULT_ADMIN_USER=admin
# Tối thiểu 10 ký tự, có cả chữ và số, không phải mật khẩu phổ biến (không đạt thì bản Production không khởi động).
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULLNAME=Quan tri vien
# Địa chỉ người dùng mở web (dùng cho CORS), ví dụ https://warehub.congty.vn
CORS_ORIGIN=http://localhost
# Cổng công khai của gateway
HTTP_PORT=80

# Kết nối Active Directory để tìm/điền nhanh thông tin nhân viên (MSNV, họ tên, bộ phận) khi lập phiếu.
# Để trống LDAP_HOST thì tắt hẳn tính năng này, không bắt buộc phải điền.
LDAP_HOST=
# 389 = LDAP thường, 636 = LDAPS. Domain controller yêu cầu "LDAP signing" (phổ biến từ 2020) thì phải
# dùng LDAPS (LDAP_USE_SSL=true, đổi port tương ứng), bind qua LDAP thường sẽ bị từ chối khi tìm kiếm dù bind "thành công".
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BASE_DN=
LDAP_BIND_USERNAME=
LDAP_BIND_PASSWORD=
# Hậu tố UPN khi đăng nhập bằng username ngắn, có dấu @ ở đầu, ví dụ @congty.com.vn
LDAP_USER_SUFFIX=
