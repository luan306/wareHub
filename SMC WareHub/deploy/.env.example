# Sao chép thành deploy/.env rồi điền giá trị thật (file .env KHÔNG được commit).
# Mật khẩu MySQL root. Đừng dùng dấu ; hoặc = vì được ghép vào chuỗi kết nối.
DB_PASSWORD=
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự; giữ nguyên qua các lần triển khai (đổi sẽ làm mọi người phải đăng nhập lại).
JWT_SECRET=
DEFAULT_ADMIN_USER=admin
# Tối thiểu 10 ký tự, có cả chữ và số, không phải mật khẩu phổ biến (không đạt thì bản Production không khởi động).
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULLNAME=Quan tri vien
# Địa chỉ người dùng mở web (dùng cho CORS), ví dụ https://warehub.congty.vn
CORS_ORIGIN=http://localhost
# Cổng công khai của gateway
HTTP_PORT=80
